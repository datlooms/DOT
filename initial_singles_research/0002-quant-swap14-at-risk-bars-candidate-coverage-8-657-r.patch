+used = set(zip(P.signal_def, P.direction)); extra = []
+for dn, k in (('SHORT', 2), ('LONG', 1)):   # 2 SHORT / 1 LONG: the weak half gets two of the three
+    s = CV[(CV.direction == dn) & ~CV.apply(lambda r: (r.signal_def, r.direction) in used, axis=1)].sort_values(['at_risk_hit', 'control_bars_hit', 'agg_pf', 'signal_def'], ascending=[False, False, False, True]).head(k)
