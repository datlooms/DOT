+import os, sys, json, numpy as np, pandas as pd
+HERE = '/home/claude/DOT/dot_master_discovery'; os.chdir(HERE)
+for d in (HERE, os.path.join(HERE, 'engine'), os.path.join(HERE, 'scanners'), os.path.join(HERE, 'orchestrator')):
+    if d not in sys.path: sys.path.insert(0, d)
+import master as MS, adm_engine as AE, score_g
+OUT = '/home/claude/swap'; os.makedirs(OUT, exist_ok=True)
+out = os.path.join(HERE, 'discovery', 'swap'); os.makedirs(out, exist_ok=True)
+df, attest, input_sha = MS.s0_ingest('data', out); ad, st = MS.s1_thresholds(df); pool, anchor, w = MS.s2_pool(df, ad, st)
+n = len(df); warm = np.arange(n) < w
+eligible = (df['ADX_Value'].values >= AE.ELIG_ADX) & (df['Volume'].values > AE.ELIG_VOL); fri = (df['EST_DayOfWeek'].values == 5) & ((df['EST_Hour'].values > 16) | ((df['EST_Hour'].values == 16) & (df['EST_Minute'].values >= 45)))
+entry_ok = eligible & (df['Volume'].values != 0) & ~fri & ~warm
+book = pd.read_csv('engine/whole_dot_signals.csv')
+ORPH = [37, 38, 48, 84, 149, 181, 205, 208, 226, 230, 231, 256, 270, 296]
+field = pd.read_csv('/mnt/project/results_F0_triple_convergence_and_d2ddir.csv'); fk = set(zip(field.signal_def, field.direction))
+chk = [i for i in range(len(book)) if (book.signal_def.iloc[i], book.direction.iloc[i]) not in fk]
+assert chk == ORPH, f'orphan indices re-derived {chk} != given {ORPH}'
+print(f'the fourteen re-derived from the 19,754 field at HEAD: {chk} — matches')
+sigs = score_g.build_book(df, pool, anchor, book, adaptive=ad, structural=st)
+masks, dirs, names = AE.build_signal_masks(df, sigs, ad, st, entry_ok, verbose=False); Mk = np.vstack(masks); dirs = np.array(dirs)
+is_o = np.zeros(len(book), bool); is_o[ORPH] = True
+ctrl = pd.read_csv('/home/claude/flat/trades_CONTROL_297.csv'); ctrl['day'] = ctrl.exit_time.str[:10]
+print('\n=== 1. AT-RISK BARS — control entry bars whose qualifying depth (build_signal_masks) falls below 3 without the fourteen ===')
+risk = []
+for dn, dv in (('LONG', 1), ('SHORT', -1)):
+    bars = np.array(sorted(ctrl[ctrl.direction == dn].entry_bar.unique()), dtype=int)
+    d_all = Mk[dirs == dv][:, bars].sum(0); d_wo = Mk[(dirs == dv) & ~is_o][:, bars].sum(0)
+    drop = bars[(d_all >= 3) & (d_wo < 3)]
+    for b in drop:
+        x = ctrl[(ctrl.entry_bar == b)]; orph_here = [i for i in ORPH if dirs[i] == dv and Mk[i, b]]
+        risk.append({'direction': dn, 'bar': int(b), 'time': df['Time'].iloc[b], 'depth_with': int(d_all[bars == b][0]), 'depth_without': int(d_wo[bars == b][0]), 'orphans_firing': orph_here, 'control_lots': len(x), 'control_bar_pnl': round(float(x.pnl.sum()), 1), 'exit_day': x.day.iloc[0]})
+    # tier-cell shifts: depth crossing 5+ -> 3/4 (gate cell changes) while staying >= 3
+    shift = bars[(d_all >= 5) & (d_wo >= 3) & (d_wo < 5)]
+    print(f'{dn}: control bars {len(bars)} · drop below floor 3: {len(drop)} · stay >=3 but drop from 5+ into the d3/d4 gate cells: {len(shift)} · bars with an orphan qualifying: {int((Mk[(dirs==dv)&is_o][:, bars].sum(0)>0).sum())}')
+R = pd.DataFrame(risk); R.to_csv(f'{OUT}/at_risk_bars.csv', index=False); print(R.to_string(index=False))
+print(f'at-risk bars total {len(R)} · control P&L on them ${R.control_bar_pnl.sum():,.1f} · lots {R.control_lots.sum()} · loss bars {int((R.control_bar_pnl<0).sum())}')
+
+print('\n=== 2. CANDIDATES — ordinary field (19,754) ∪ catalogue VALID, agg_pf >= 2.0, not in the 297; ranked by at-risk bars reached, per direction ===')
+cat = pd.read_csv('/mnt/project/catalogue_F0.csv', comment='#'); cat = cat[cat.verdict == 'VALID']
+cand = pd.concat([field[['signal_def', 'direction', 'agg_pf', 'trades', 'worst_day_usd', 'hard_stop_days']].assign(src='field'),
+                  cat[['signal_def', 'direction', 'agg_pf', 'trades', 'worst_day_usd']].assign(src='catalogue', hard_stop_days=np.nan)], ignore_index=True)
+cand = cand[cand.agg_pf >= 2.0].drop_duplicates(['signal_def', 'direction'])
+bk = set(zip(book.signal_def, book.direction)); cand = cand[~cand.apply(lambda r: (r.signal_def, r.direction) in bk, axis=1)].reset_index(drop=True)
+print(f'candidates: {len(cand)} (LONG {int((cand.direction=="LONG").sum())} / SHORT {int((cand.direction=="SHORT").sum())}); field rows >=2.0 {int((field.agg_pf>=2).sum())}, catalogue VALID {len(cat)}')
+rows = []
+rb = {dn: R[R.direction == dn].bar.values.astype(int) for dn in ('LONG', 'SHORT')}
+allb = {dn: np.array(sorted(ctrl[ctrl.direction == dn].entry_bar.unique()), dtype=int) for dn in ('LONG', 'SHORT')}
+CH = 400
+for s0 in range(0, len(cand), CH):
+    part = cand.iloc[s0:s0 + CH]
+    cb = pd.DataFrame({'trigger': 'F0', 'direction': part.direction.values, 'signal_def': part.signal_def.values})
+    csigs = score_g.build_book(df, pool, anchor, cb, adaptive=ad, structural=st)
+    cm, cd, cn = AE.build_signal_masks(df, csigs, ad, st, entry_ok, verbose=False)
+    for j, m in enumerate(cm):
+        dn = part.direction.iloc[j]; hit = m[rb[dn]] if len(rb[dn]) else np.zeros(0, bool)
+        rows.append({'direction': dn, 'signal_def': part.signal_def.iloc[j], 'src': part.src.iloc[j], 'agg_pf': part.agg_pf.iloc[j], 'trades_scan': part.trades.iloc[j], 'at_risk_hit': int(hit.sum()), 'at_risk_bars': [int(b) for b in rb[dn][hit]], 'control_bars_hit': int(m[allb[dn]].sum()), 'qualifying_bars': int(m.sum())})
+    del cm
+    if (s0 // CH) % 5 == 0: print(f'  masks {s0 + len(part)}/{len(cand)}', flush=True)
+CV = pd.DataFrame(rows); CV.to_csv(f'{OUT}/candidate_coverage.csv', index=False)
+for dn in ('LONG', 'SHORT'):
+    s = CV[CV.direction == dn]; rb = R[R.direction == dn].bar.values.astype(int)
+    print(f'\n--- {dn}: {len(s)} candidates; at-risk bars {len(rb)}; candidates reaching >=1 at-risk bar: {int((s.at_risk_hit>0).sum())}; reachable at-risk bars (covered by any candidate): {len(set(b for l in s.at_risk_bars for b in l))} of {len(rb)} ---')
+    print(s.sort_values(['at_risk_hit', 'agg_pf'], ascending=[False, False]).head(15)[['signal_def', 'src', 'agg_pf', 'trades_scan', 'at_risk_hit', 'at_risk_bars', 'control_bars_hit', 'qualifying_bars']].to_string(index=False))
+    # how many candidates to cover all reachable at-risk bars (greedy, pf tie-break) — set cover count
+    uncovered = set(int(b) for b in rb); chosen = []
+    s2 = s.copy()
+    while uncovered:
+        s2['gain'] = s2.at_risk_bars.apply(lambda l: len(set(l) & uncovered))
+        if s2.gain.max() == 0: break
+        best = s2.sort_values(['gain', 'agg_pf', 'signal_def'], ascending=[False, False, True]).iloc[0]
+        chosen.append(best.signal_def); uncovered -= set(best.at_risk_bars); s2 = s2[s2.signal_def != best.signal_def]
+    print(f'{dn} greedy set cover: {len(chosen)} candidates cover {len(rb)-len(uncovered)} of {len(rb)} at-risk bars; uncoverable: {sorted(uncovered)}')
+    json.dump({'chosen': chosen, 'uncoverable': sorted(uncovered)}, open(f'{OUT}/setcover_{dn}.json', 'w'))
