+import os, sys, json, ast, numpy as np, pandas as pd
+HERE = '/home/claude/DOT/dot_master_discovery'; os.chdir(HERE)
+for d in (HERE, os.path.join(HERE, 'engine'), os.path.join(HERE, 'scanners'), os.path.join(HERE, 'orchestrator')):
+    if d not in sys.path: sys.path.insert(0, d)
+import master as MS, adm_engine as AE, swept_thresholds as SW, cluster_profiler as CP, conviction as C, score_g, two_moment_check as TM
+OUT = '/home/claude/swap'
+out = os.path.join(HERE, 'discovery', 'swap')
+df, attest, input_sha = MS.s0_ingest('data', out); ad, st = MS.s1_thresholds(df); pool, anchor, w = MS.s2_pool(df, ad, st)
+cfg, cfg_path = MS.book_config_for('engine/whole_dot_signals.csv'); cv = cfg['conviction']
+conv = C.build_conviction(df, bool(cv['hurst']), bool(cv['recentfb']), bool(cv['d2d']), d2d_conviction=bool(cv['d2d_conviction']), d2d_gap=bool(cv['d2d_gap'])); G = SW.build_whole_dot_gates(df)
+book = pd.read_csv('engine/whole_dot_signals.csv'); ORPH = [37, 38, 48, 84, 149, 181, 205, 208, 226, 230, 231, 256, 270, 296]
+CV = pd.read_csv(f'{OUT}/candidate_coverage.csv'); CV['at_risk_bars'] = CV.at_risk_bars.apply(ast.literal_eval)
+SLOTS = {'LONG': 6, 'SHORT': 8}; picks = []
+for dn in ('LONG', 'SHORT'):
+    s = CV[CV.direction == dn].copy(); risk = set(b for l in s.at_risk_bars for b in l); uncovered = set(risk); chosen = []
+    while uncovered and len(chosen) < SLOTS[dn]:
+        s['gain'] = s.at_risk_bars.apply(lambda l: len(set(l) & uncovered))
+        if s.gain.max() == 0: break
+        best = s.sort_values(['gain', 'agg_pf', 'signal_def'], ascending=[False, False, True]).iloc[0]
+        chosen.append((best.signal_def, 'COVER', int(best.gain))); uncovered -= set(best.at_risk_bars); s = s[s.signal_def != best.signal_def]
+    rest = s.sort_values(['at_risk_hit', 'control_bars_hit', 'agg_pf', 'signal_def'], ascending=[False, False, False, True])
+    for r in rest.head(SLOTS[dn] - len(chosen)).itertuples(): chosen.append((r.signal_def, 'FILL', 0))
+    for sd, role, gain in chosen:
+        r = CV[(CV.direction == dn) & (CV.signal_def == sd)].iloc[0]
+        picks.append({'direction': dn, 'signal_def': sd, 'role': role, 'new_at_risk_covered': gain, 'at_risk_hit': r.at_risk_hit, 'control_bars_hit': r.control_bars_hit, 'qualifying_bars': r.qualifying_bars, 'agg_pf': r.agg_pf, 'trades_scan': r.trades_scan, 'src': r.src})
+    print(f'{dn}: at-risk {len(risk)} · covered by the picks {len(risk) - len(uncovered)} · uncoverable {sorted(uncovered)}')
+P = pd.DataFrame(picks); P.to_csv(f'{OUT}/replacements.csv', index=False); print(P.to_string(index=False))
+keep = book.drop(index=ORPH).reset_index(drop=True)
+add = pd.DataFrame({'trigger': 'F0', 'direction': P.direction.values, 'signal_def': P.signal_def.values})
+b300 = pd.concat([keep[['trigger', 'direction', 'signal_def']], add], ignore_index=True); b300.to_csv(f'{OUT}/whole_dot_300_signals.csv', index=False)
+print(f'300 book: {len(b300)} rows (LONG {int((b300.direction=="LONG").sum())} / SHORT {int((b300.direction=="SHORT").sum())})')
+sigs = score_g.build_book(df, pool, anchor, b300, adaptive=ad, structural=st); TM.configure(df, cfg, G, {1: 3, -1: 3}, True)
+td = AE.run_portfolio(df, sigs, adaptive=ad, structural=st, warmup=w, verbose=False, conviction=conv); td = td[~td['signal_name'].isin(CP.GAP_NAMES)].copy(); td.to_csv(f'{OUT}/trades_300.csv', index=False)
+s = TM.score(td, 'THE 300 = 297 - fourteen + fourteen replacements (IN-SAMPLE)'); print('RESULT ' + json.dumps(s, default=float)); json.dump(s, open(f'{OUT}/result_300.json', 'w'), indent=1, default=float)
+ctrl = pd.read_csv('/home/claude/flat/trades_CONTROL_297.csv')
+def monthly(t, lab):
+    t = t.copy(); t['m'] = t.exit_time.astype(str).str[:7]; rows = []
+    for m, x in t.groupby('m'):
+        p = x.pnl.values; bars = x.groupby('entry_bar').pnl.sum(); bd = x.groupby(x.exit_time.astype(str).str[:10]).pnl.sum(); ev = int((bars < 0).sum())
+        rows.append({'book': lab, 'month': m, 'trades': len(x), 'bars': len(bars), 'events': ev, 'worst_day': round(bd.min(), 1), 'losing_days': int((bd < 0).sum()), 'days': len(bd), 'WR': round(100 * (p > 0).mean(), 2), 'PF': (round(p[p > 0].sum() / max(1e-9, -p[p < 0].sum()), 2) if ev >= 20 else f'({ev} ev)'), 'net': round(p.sum())})
+    return pd.DataFrame(rows)
+Mth = pd.concat([monthly(ctrl, '297'), monthly(td, '300')]); Mth.to_csv(f'{OUT}/monthly_297_vs_300.csv', index=False); print(Mth.to_string(index=False))
+# weekly check and where the 300 differs from the control on the at-risk bars
+d = pd.to_datetime(td.exit_time.str[:10], format='%Y.%m.%d'); wk = d.dt.isocalendar(); td['wk'] = wk.year.astype(str) + '-W' + wk.week.astype(str); bw = td.groupby('wk').pnl.sum()
+print('300 losing weeks:', bw[bw < 0].round(1).to_dict())
+R = pd.read_csv(f'{OUT}/at_risk_bars.csv'); tb = td.groupby('entry_bar').agg(pnl=('pnl', 'sum'), lots=('pnl', 'size'))
+print('at-risk bars in the 300: traded', int(R.bar.isin(tb.index).sum()), 'of', len(R), '| control bars lost by the 300:', len(set(ctrl.entry_bar) - set(td.entry_bar)), '| new bars:', len(set(td.entry_bar) - set(ctrl.entry_bar)))
+new = td[~td.entry_bar.isin(set(ctrl.entry_bar))]; nb = new.groupby('entry_bar').pnl.sum(); print(f'new bars: {len(nb)} · events {int((nb<0).sum())} · net {nb.sum():.1f} · worst {nb.min():.1f}')
+print('ENGINE TRIALS THIS SCRIPT: 1')
