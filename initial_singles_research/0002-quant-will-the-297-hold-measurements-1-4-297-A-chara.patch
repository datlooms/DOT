+import os, sys, json, numpy as np, pandas as pd
+HERE = '/home/claude/DOT/dot_master_discovery'
+os.chdir(HERE)
+for d in (HERE, os.path.join(HERE, 'engine'), os.path.join(HERE, 'scanners'), os.path.join(HERE, 'orchestrator')):
+    if d not in sys.path: sys.path.insert(0, d)
+import master as MS, adm_engine as AE, swept_thresholds as SW, cluster_profiler as CP, conviction as C, score_g
+OUT = '/home/claude/hold'
+out = os.path.join(HERE, 'discovery', 'hold'); os.makedirs(out, exist_ok=True)
+df, attest, input_sha = MS.s0_ingest('data', out)
+ad, st = MS.s1_thresholds(df)
+pool, anchor, w = MS.s2_pool(df, ad, st)
+cfg, cfg_path = MS.book_config_for('engine/whole_dot_signals.csv'); cv = cfg['conviction']
+conv = C.build_conviction(df, bool(cv['hurst']), bool(cv['recentfb']), bool(cv['d2d']), d2d_conviction=bool(cv['d2d_conviction']), d2d_gap=bool(cv['d2d_gap']))
+G = SW.build_whole_dot_gates(df)
+n = len(df); warm = np.arange(n) < w
+eligible = (df['ADX_Value'].values >= AE.ELIG_ADX) & (df['Volume'].values > AE.ELIG_VOL)
+vol_zero = df['Volume'].values == 0
+fri_block = (df['EST_DayOfWeek'].values == 5) & ((df['EST_Hour'].values > 16) | ((df['EST_Hour'].values == 16) & (df['EST_Minute'].values >= 45)))
+entry_ok = eligible & ~vol_zero & ~fri_block & ~warm
+atr_ok = df['ATR_1M'].values >= float(cfg['global_gate']['value'])
+d2d = df['D2D_Trend_Dir'].values
+cond_names = sorted(pool); ci = {c: i for i, c in enumerate(cond_names)}; Pm = np.vstack([pool[c] for c in cond_names])
+
+def configure_297():
+    AE.ADMISSION_RULE = 'FLOORED'; AE.MAX_POSITIONS = int(cfg['max_positions']); AE.ADM_FLOOR = {1: 3, -1: 3}
+    AE.ADM_GATES = {'ATR': df['ATR_1M'].values.astype(float), 'atr_min': float(cfg['global_gate']['value'])}
+    _NAME = {('Micro_Hurst', 90): 'HU90', ('Micro_FailedBreak', 20): 'FB20', ('AT_Slope_ST', 90): 'ATS90'}
+    tg = {}
+    for dname, dv in (('LONG', 1), ('SHORT', -1)):
+        for tier, gates in cfg['tier_gates'][dname].items():
+            if not gates: continue
+            t = 5 if tier == '5+' else int(tier); tg[(dv, t)] = [G[_NAME[(g['variable'], int(g['pct']))]] for g in gates]
+    AE.ADM_TIERGATES = tg
+def score(td, tag):
+    p = td['pnl'].values.astype(float); tl, ev, dy = MS.loss_events(td)
+    day = pd.Series(td['exit_time'].astype(str).values).str[:10].values; byday = pd.Series(p).groupby(day).sum()
+    iso = pd.to_datetime(pd.Series(td['exit_time'].astype(str).values).str[:10], format='%Y.%m.%d')
+    wk = iso.dt.isocalendar().set_index(iso.index)[['year', 'week']].astype(str).agg('-W'.join, axis=1).values; byweek = pd.Series(p).groupby(wk).sum()
+    bybar = td.groupby('entry_bar').agg(pnl=('pnl', 'sum'), lots=('pnl', 'size')); wins = p[p > 0]; losses = -p[p < 0]
+    be = (losses.mean() / (wins.mean() + losses.mean()) * 100) if len(losses) and len(wins) else 0.0; wr = 100 * (p > 0).mean()
+    return {'tag': tag, 'loss_events': ev, 'worst_bar': round(float(bybar.pnl.min()), 2), 'worst_day': round(float(byday.min()), 2), 'losing_weeks': int((byweek < 0).sum()), 'weeks': int(len(byweek)), 'days': int(len(byday)), 'loss_days': dy,
+            'entry_bars': int(len(bybar)), 'trades': int(len(td)), 'WR': round(wr, 2), 'PF': round(wins.sum() / losses.sum(), 2), 'MARGIN': round(wr - be, 2), 'net': round(p.sum(), 2), 'lots_per_bar_mean': round(float(bybar.lots.mean()), 2), 'breach_2500': int((byday < -2500).sum())}
+TRIALS = [0]
+def run_book(bk, tag):
+    sigs = score_g.build_book(df, pool, anchor, bk, adaptive=ad, structural=st); configure_297(); TRIALS[0] += 1
+    td = AE.run_portfolio(df, sigs, adaptive=ad, structural=st, warmup=w, verbose=False, conviction=conv)
+    td = td[~td['signal_name'].isin(CP.GAP_NAMES)].copy(); s = score(td, tag); s['trial_no'] = TRIALS[0]; print('RESULT ' + json.dumps(s), flush=True)
+    with open(f'{OUT}/additions_results.jsonl', 'a') as f: f.write(json.dumps(s) + '\n')
+    return s, td
+
+book = pd.read_csv('engine/whole_dot_signals.csv')
+ctrl_s, ctrl_td = run_book(book, 'CONTROL_297')
+traded_all = set(ctrl_td.entry_bar)
+pops = json.load(open('/home/claude/partB/populations.json')); m3 = json.load(open(f'{OUT}/m3_churn.json'))
+A_not = {dn: set(pops[dn]['A\\297']) for dn in ('LONG', 'SHORT')}
+TURN = m3['TURN_full']; LOC = m3['LOC_full']
+MISSING = {'LONG': ['AT_Score_ST:lo', 'D2D_Up_Count:hi', 'D2D_Persist:lo', 'KAMA_Slope:lo'], 'SHORT': ['EMA_Oscillator:hi', 'AT_Score_ST:hi', 'KAMA_Dist_ATR:hi', 'KAMA_Slope:hi']}
+cat = pd.read_csv('/mnt/project/catalogue_F0.csv', comment='#'); cat = cat[cat.verdict == 'VALID']
+inbook = set(zip(book.signal_def, book.direction))
+cand = cat[~cat.apply(lambda r: (r.signal_def, r.direction) in inbook, axis=1)].copy()
+print(f'universe: VALID {len(cat)} · not in the 297: {len(cand)}')
+cand['conds'] = cand.signal_def.apply(lambda s: [t.strip() for t in s.split('+')])
+cand['cls_missing'] = cand.apply(lambda r: any(c in MISSING[r.direction] for c in r.conds), axis=1)
+cand['cls_location'] = cand.apply(lambda r: any(c in LOC[r.direction] for c in r.conds), axis=1)
+print(f'MISSING-TURN class: {int(cand.cls_missing.sum())} (LONG {int((cand.cls_missing&(cand.direction=="LONG")).sum())} / SHORT {int((cand.cls_missing&(cand.direction=="SHORT")).sum())}) · LOCATION class: {int(cand.cls_location.sum())} (LONG {int((cand.cls_location&(cand.direction=="LONG")).sum())} / SHORT {int((cand.cls_location&(cand.direction=="SHORT")).sum())}) · both {int((cand.cls_missing&cand.location if False else (cand.cls_missing&cand.cls_location)).sum())}')
+sub = cand[cand.cls_missing | cand.cls_location].copy()
+bk = pd.DataFrame({'trigger': 'F0', 'direction': sub.direction.values, 'signal_def': sub.signal_def.values})
+sigs = score_g.build_book(df, pool, anchor, bk, adaptive=ad, structural=st)
+masks, dirs, names = AE.build_signal_masks(df, sigs, ad, st, entry_ok, verbose=False)
+rows = []
+for i, (r, m) in enumerate(zip(sub.itertuples(), masks)):
+    dn = r.direction; m = m & atr_ok; q = np.where(m)[0]
+    tc = Pm[[ci[c] for c in TURN[dn]]].sum(0); lc = Pm[[ci[c] for c in LOC[dn]]].sum(0)
+    in297 = sum(1 for b in q if b in traded_all); inA = sum(1 for b in q if b in A_not[dn]); new = [b for b in q if b not in traded_all and b not in A_not[dn]]
+    shaped = sum(1 for b in new if lc[b] >= 1 and tc[b] <= 1)
+    rows.append({'signal_def': r.signal_def, 'direction': dn, 'cls_missing': r.cls_missing, 'cls_location': r.cls_location, 'qual_bars': len(q), 'on_297': in297, 'on_A_not297': inA, 'new': len(new), 'new_297A_shaped': shaped, 'cat_trades': r.trades, 'cat_pf': r.agg_pf, 'cat_worst_day': r.worst_day_usd, 'cat_n_losses': r.n_losses})
+CV = pd.DataFrame(rows); CV.to_csv(f'{OUT}/additions_candidates.csv', index=False)
+sel = []
+for cls in ('cls_missing', 'cls_location'):
+    for dn in ('LONG', 'SHORT'):
+        s = CV[(CV[cls]) & (CV.direction == dn)].sort_values(['new_297A_shaped', 'cat_pf'], ascending=[False, False]).head(3)
+        for r in s.itertuples(): sel.append({'class': cls.replace('cls_', ''), 'direction': dn, 'signal_def': r.signal_def, 'qual_bars': r.qual_bars, 'on_297': r.on_297, 'on_A_not297': r.on_A_not297, 'new': r.new, 'new_297A_shaped': r.new_297A_shaped, 'cat_pf': r.cat_pf, 'cat_worst_day': r.cat_worst_day, 'cat_n_losses': r.cat_n_losses})
+SEL = pd.DataFrame(sel).drop_duplicates('signal_def'); SEL.to_csv(f'{OUT}/additions_selected.csv', index=False)
+print('SELECTED (pre-registered rule: top-3 per class x direction by NEW 297\\A-shaped bars):'); print(SEL.to_string(index=False))
+def add_rows(defs):
+    extra = pd.DataFrame([{'trigger': 'F0', 'direction': SEL[SEL.signal_def == s].direction.iloc[0], 'signal_def': s} for s in defs]); return pd.concat([book, extra], ignore_index=True)
+results = []
+for r in SEL.itertuples():
+    s, _ = run_book(add_rows([r.signal_def]), f'297+[{r.direction}] {r.signal_def}'); results.append(s)
+for cls in ('missing', 'location'):
+    defs = SEL[SEL['class'] == cls].signal_def.tolist(); run_book(add_rows(defs), f'297+ALL {cls} ({len(defs)})')
+run_book(add_rows(SEL.signal_def.tolist()), f'297+ALL selected ({len(SEL)})')
+print('ENGINE TRIALS THIS SCRIPT (incl. control):', TRIALS[0])
