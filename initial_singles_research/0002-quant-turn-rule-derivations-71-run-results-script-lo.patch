+print(f'GATE MASKS: HU90 {100*G["HU90"].mean():.4f}%  FB20 {100*G["FB20"].mean():.4f}%  ATS90 {100*G["ATS90"].mean():.4f}%')
+n = len(df)
+warm = np.arange(n) < w
+eligible = (df['ADX_Value'].values >= AE.ELIG_ADX) & (df['Volume'].values > AE.ELIG_VOL)
+vol_zero = df['Volume'].values == 0
+fri_block = (df['EST_DayOfWeek'].values == 5) & ((df['EST_Hour'].values > 16) | ((df['EST_Hour'].values == 16) & (df['EST_Minute'].values >= 45)))
+entry_ok = eligible & ~vol_zero & ~fri_block & ~warm
+atr_ok = df['ATR_1M'].values >= float(cfg['global_gate']['value'])
+d2d = df['D2D_Trend_Dir'].values; hour = df['EST_Hour'].values
+month = pd.Series(df['Time'].astype(str).values).str[:7].values
+cond_names = sorted(pool); ci = {c: i for i, c in enumerate(cond_names)}
+Pm = np.vstack([pool[c] for c in cond_names])
+
+# ---- control (297), reproduced through this path ----
+def configure_297():
+    AE.ADMISSION_RULE = 'FLOORED'; AE.MAX_POSITIONS = int(cfg['max_positions']); AE.ADM_FLOOR = {1: 3, -1: 3}
+    AE.ADM_GATES = {'ATR': df['ATR_1M'].values.astype(float), 'atr_min': float(cfg['global_gate']['value'])}
+    _NAME = {('Micro_Hurst', 90): 'HU90', ('Micro_FailedBreak', 20): 'FB20', ('AT_Slope_ST', 90): 'ATS90'}
+    tg = {}
+    for dname, dv in (('LONG', 1), ('SHORT', -1)):
+        for tier, gates in cfg['tier_gates'][dname].items():
+            if not gates: continue
+            t = 5 if tier == '5+' else int(tier)
+            tg[(dv, t)] = [G[_NAME[(g['variable'], int(g['pct']))]] for g in gates]
+    AE.ADM_TIERGATES = tg
+def configure_rule():
+    AE.ADMISSION_RULE = 'FLOORED'; AE.MAX_POSITIONS = int(cfg['max_positions']); AE.ADM_FLOOR = {1: 1, -1: 1}
+    AE.ADM_GATES = {'ATR': df['ATR_1M'].values.astype(float), 'atr_min': float(cfg['global_gate']['value'])}
+    _NAME = {('Micro_Hurst', 90): 'HU90', ('Micro_FailedBreak', 20): 'FB20', ('AT_Slope_ST', 90): 'ATS90'}
+    tg = {}
+    for dname, dv in (('LONG', 1), ('SHORT', -1)):
+        gates = cfg['tier_gates'][dname]['5+']
+        if gates: tg[(dv, 1)] = [G[_NAME[(g['variable'], int(g['pct']))]] for g in gates]
+    AE.ADM_TIERGATES = tg
+
+def max_concurrent(td):
+    ev = []
+    for r in td.itertuples(): ev.append((r.entry_bar, 1)); ev.append((r.exit_bar, -1))
+    ev.sort(key=lambda x: (x[0], x[1])); cur = mx = 0
+    for _, dd in ev:
+        cur += dd; mx = max(mx, cur)
+    return mx
+def score(td, tag):
+    if len(td) == 0: return {'tag': tag, 'trades': 0}
+    p = td['pnl'].values.astype(float)
+    tl, ev, dy = MS.loss_events(td)
+    day = pd.Series(td['exit_time'].astype(str).values).str[:10].values
+    byday = pd.Series(p).groupby(day).sum()
+    iso = pd.to_datetime(pd.Series(td['exit_time'].astype(str).values).str[:10], format='%Y.%m.%d')
+    wk = iso.dt.isocalendar().set_index(iso.index)[['year', 'week']].astype(str).agg('-W'.join, axis=1).values
+    byweek = pd.Series(p).groupby(wk).sum()
+    bybar = td.groupby('entry_bar').agg(pnl=('pnl', 'sum'), lots=('pnl', 'size'))
+    wins = p[p > 0]; losses = -p[p < 0]
+    be = (losses.mean() / (wins.mean() + losses.mean()) * 100) if len(losses) and len(wins) else 0.0
+    wr = 100 * (p > 0).mean(); pf = wins.sum() / losses.sum() if len(losses) else float('inf')
+    return {'tag': tag, 'loss_events': ev, 'worst_bar': round(float(bybar.pnl.min()), 2), 'worst_day': round(float(byday.min()), 2),
+            'losing_weeks': int((byweek < 0).sum()), 'weeks': int(len(byweek)), 'days': int(len(byday)), 'loss_days': dy,
+            'entry_bars': int(len(bybar)), 'trades': int(len(td)), 'WR': round(wr, 2), 'PF': round(pf, 2), 'BE_WR': round(be, 2), 'MARGIN': round(wr - be, 2), 'net': round(p.sum(), 2),
+            'lots_per_bar_mean': round(float(bybar.lots.mean()), 2), 'max_concurrent': int(max_concurrent(td)), 'breach_2500': int((byday < -2500).sum())}
+
+book = pd.read_csv('engine/whole_dot_signals.csv')
+bsigs = score_g.build_book(df, pool, anchor, book, adaptive=ad, structural=st)
+configure_297()
+td_full = AE.run_portfolio(df, bsigs, adaptive=ad, structural=st, warmup=w, verbose=False, conviction=conv)
+ctrl = td_full[~td_full['signal_name'].isin(CP.GAP_NAMES)].copy()
+print('CONTROL ' + json.dumps(score(ctrl, 'CONTROL_297')), flush=True)
+traded_bars = {1: np.array(sorted(ctrl[ctrl.direction == 'LONG'].entry_bar.unique())), -1: np.array(sorted(ctrl[ctrl.direction == 'SHORT'].entry_bar.unique()))}
+traded_all = set(ctrl.entry_bar)
+TRIALS = [1]
+
+# ---- derivation on a prefix mask ----
+def derive(prefix_mask, label):
+    res = {}
+    for dv, dn in ((1, 'LONG'), (-1, 'SHORT')):
+        tb = np.array([b for b in traded_bars[dv] if prefix_mask[b]])
+        elig = np.where(entry_ok & atr_ok & (d2d == dv) & prefix_mask)[0]
+        ub = np.array([b for b in elig if b not in traded_all])
+        if len(tb) == 0 or len(ub) == 0:
+            res[dn] = {'status': 'UNDERIVABLE', 'traded_bars': int(len(tb)), 'untraded_bars': int(len(ub)), 'T': [], 'S': []}; continue
+        th = Counter(hour[tb]); uh = Counter(hour[ub])
+        wts = np.array([th[hour[b]] / uh[hour[b]] if uh[hour[b]] else 0.0 for b in ub])
+        if wts.sum() == 0: wts = np.ones(len(ub))
+        wts = wts / wts.sum()
+        t = Pm[:, tb].mean(1); u = (Pm[:, ub] * wts).sum(1); cnt = Pm[:, tb].sum(1)
+        with np.errstate(divide='ignore', invalid='ignore'): lift = np.where(u > 0, t / u, np.inf)
+        cand = [(lift[i], cond_names[i], int(cnt[i]), float(t[i]), float(u[i])) for i in range(len(cond_names)) if cnt[i] >= MIN_TRADED and u[i] > 0]
+        cand.sort(key=lambda x: -x[0])
+        T = cand[:N_TURN]
+        S = [(lift[i], cond_names[i], int(cnt[i]), float(t[i]), float(u[i])) for i in range(len(cond_names)) if u[i] >= SUP_URATE and lift[i] <= SUP_LIFT]
+        res[dn] = {'status': 'OK' if len(T) else 'UNDERIVABLE', 'traded_bars': int(len(tb)), 'untraded_bars': int(len(ub)), 'n_candidates': len(cand),
+                   'T': [{'condition': c, 'lift': round(l, 3), 'traded_true': k_, 'traded_rate': round(tr, 4), 'untraded_rate': round(ur, 4)} for l, c, k_, tr, ur in T],
+                   'S': [{'condition': c, 'lift': round(l, 3), 'traded_true': k_, 'traded_rate': round(tr, 4), 'untraded_rate': round(ur, 4)} for l, c, k_, tr, ur in S]}
+    print(f'DERIVE [{label}] LONG traded {res["LONG"]["traded_bars"]} untraded {res["LONG"]["untraded_bars"]} T=' + ', '.join(f'{x["condition"]}(x{x["lift"]:.1f},{x["traded_true"]}b)' for x in res['LONG']['T']) + ' | S=' + ', '.join(f'{x["condition"]}(x{x["lift"]:.2f})' for x in res['LONG']['S']), flush=True)
+    print(f'DERIVE [{label}] SHORT traded {res["SHORT"]["traded_bars"]} untraded {res["SHORT"]["untraded_bars"]} T=' + ', '.join(f'{x["condition"]}(x{x["lift"]:.1f},{x["traded_true"]}b)' for x in res['SHORT']['T']) + ' | S=' + ', '.join(f'{x["condition"]}(x{x["lift"]:.2f})' for x in res['SHORT']['S']), flush=True)
+    return res
+
+def rule_mask(der, dv, k):
+    dn = 'LONG' if dv == 1 else 'SHORT'
+    T = [ci[x['condition']] for x in der[dn]['T']]; S = [ci[x['condition']] for x in der[dn]['S']]
+    if len(T) < k: return None
+    turn = Pm[T].sum(0) >= k
+    sup = Pm[S].any(0) if S else np.zeros(n, dtype=bool)
+    return entry_ok & atr_ok & (d2d == dv) & turn & ~sup
+
+def sigs_for(masks, conv_name):
+    rows = []
+    for dv, dn in ((1, 'LONG'), (-1, 'SHORT')):
+        m = masks[dv]
+        if m is None: m = np.zeros(n, dtype=bool)
+        if conv_name == 'ONE':
+            col = f'__R_{dn}'; df[col] = m.astype(int)
+            rows.append({'feat_1': col, 'thresh_1': '==1', 'feat_2': col, 'thresh_2': '==1', 'feat_3': col, 'thresh_3': '==1', 'direction': dn})
+        else:
+            q = np.where(m)[0]
+            for j in range(K_RR):
+                col = f'__RR_{dn}_{j}'; a = np.zeros(n, dtype=int); a[q[j::K_RR]] = 1; df[col] = a
+                rows.append({'feat_1': col, 'thresh_1': '==1', 'feat_2': col, 'thresh_2': '==1', 'feat_3': col, 'thresh_3': '==1', 'direction': dn})
+    return pd.DataFrame(rows)
+
+def run(der, k, conv_name, tag, window=None, extra=None):
+    masks = {1: rule_mask(der, 1, k), -1: rule_mask(der, -1, k)}
+    if masks[1] is None and masks[-1] is None:
+        s = {'tag': tag, 'k': k, 'convention': conv_name, 'status': 'UNDERIVABLE'}; print('RESULT ' + json.dumps(s)); return s, None
+    configure_rule()
+    sigs = sigs_for(masks, conv_name)
+    TRIALS[0] += 1
+    td_full = AE.run_portfolio(df, sigs, mask_window=window, adaptive=ad, structural=st, warmup=w, verbose=False, conviction=conv)
+    td = td_full[~td_full['signal_name'].isin(CP.GAP_NAMES)].copy()
+    s = score(td, tag); s.update({'k': k, 'convention': conv_name, 'status': 'OK', 'trial_no': TRIALS[0]})
+    for dv, dn in ((1, 'LONG'), (-1, 'SHORT')):
+        m = masks[dv]
+        if m is not None:
+            mm = m & (window if window is not None else True)
+            s[f'rule_bars_{dn}'] = int(mm.sum()); s[f'rule_bars_{dn}_in_297'] = int(sum(1 for b in np.where(mm)[0] if b in traded_all))
+            s[f'rule_LONG_T' if dv == 1 else 'rule_SHORT_T'] = [x['condition'] for x in der[dn]['T']]
+    if extra: s.update(extra)
+    print('RESULT ' + json.dumps(s), flush=True)
+    with open(f'{OUT}/results.jsonl', 'a') as f: f.write(json.dumps(s) + '\n')
+    if td is not None and len(td): td.to_csv(f'{OUT}/trades_{tag}.csv', index=False)
+    return s, td
+
+derivs = {}
+# ---- C: full-frame derivation ----
+full = ~warm
+derivs['FULL'] = derive(full, 'FULL frame')
+print('\n=== B. BARS FOUND (full-frame derivation), before scoring ===')
+for k in K_GRID:
+    for dv, dn in ((1, 'LONG'), (-1, 'SHORT')):
+        m = rule_mask(derivs['FULL'], dv, k)
+        if m is None: print(f'k={k} {dn}: UNDERIVABLE'); continue
+        bars = np.where(m)[0]; inb = sum(1 for b in bars if b in traded_all)
+        print(f'k={k} {dn}: rule bars {len(bars):>5} · in the 297\'s {len(traded_bars[dv])}: {inb:>4} · 297 bars the rule misses {len(traded_bars[dv]) - inb:>4} · rule bars the book never traded {len(bars) - inb:>5}')
+if MODE in ('all', 'C'):
+    print('\n=== C. FULL-FRAME SETUP (in-sample) ===')
+    for k in K_GRID:
+        for cn in ('ONE', 'RR'): run(derivs['FULL'], k, cn, f'FULL_k{k}_{cn}', extra={'window': 'FULL'})
+# ---- D: walk-forward on sacred wf.FOLDS + July extra ----
+if MODE in ('all', 'D'):
+    print('\n=== D. WALK-FORWARD: derived on prefix months, scored on the fold month only ===')
+    windows = [(lbl, key) for lbl, key in wf.FOLDS] + [('Jul(1-21) EXTRA', '2026.07')]
+    for lbl, key in windows:
+        prefix = (month < key) & ~warm; win = (month == key)
+        if prefix.sum() == 0:
+            print(f'[{lbl}] prefix empty -> UNDERIVABLE (reported, not scored)'); continue
+        der = derive(prefix, f'prefix<{key} for {lbl}'); derivs[key] = der
+        for k in K_GRID:
+            for cn in ('ONE', 'RR'): run(der, k, cn, f'WF_{key}_k{k}_{cn}', window=win, extra={'window': key, 'fold': lbl})
