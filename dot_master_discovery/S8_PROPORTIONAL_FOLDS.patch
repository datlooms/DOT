-    fmin = min((_pf(p[mo == m]) for m in FOLDS if (mo == m).any()), default=0.0)
-    fplus = sum(1 for m in FOLDS if p[mo == m].sum() > 0)
+    exit_day = pd.Series(td['exit_time'].astype(str).values).str[:10].values
+    plan = fold_plan(df, w)
