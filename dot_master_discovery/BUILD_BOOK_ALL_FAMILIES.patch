+        mark_done(out, 'S5B', {'input_sha': input_sha, 'effective_vocabulary': int(hyg['effective_vocabulary'].iloc[0])})
+
     return {'report_lines': report_lines, 'hygiene': hyg, 'grid': grid, 'constraints': con, 'h3': h3}
 
 
